{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"noEmit": true,
		"jsx": "react-jsx",
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"types": ["node"]
	},
	"include": [
		"src/**/*.ts",
		"src/**/*.tsx",
		"playground/**/*.ts",
		"playground/**/*.tsx",
		"tsdown.config.ts",
		"types/**/*.d.ts"
	]
}
