{
	"name": "@sirosfoundation/ui",
	"description": "Web UI library",
	"version": "0.0.0",
	"type": "module",
	"license": "BSD-2-Clause",
	"exports": {
		"./css": {
			"types": "./types/css.d.ts",
			"default": "./dist/css/index.css"
		},
		"./css/*": {
			"types": "./types/css.d.ts",
			"default": "./dist/css/*.css"
		},
		"./react": {
			"types": "./dist/react/index.d.mts",
			"default": "./dist/react/index.mjs"
		},
		"./react/*": {
			"types": "./dist/react/*.d.mts",
			"default": "./dist/react/*.mjs"
		}
	},
	"files": [
		"dist",
		"types"
	],
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"clean": "rm -rf dist/",
		"typecheck": "tsc --noEmit",
		"lint": "biome check",
		"lint:fix": "biome check --write",
		"format": "biome format --write",
		"playground:dev": "pnpm --filter ui-playground dev",
		"playground:build": "pnpm --filter ui-playground build"
	},
	"dependencies": {
		"@fontsource/inter": "^5.3.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.10",
		"@changesets/changelog-github": "^1.0.0",
		"@changesets/cli": "^3.0.1",
		"@types/node": "^26.2.0",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"lucide-react": "^1.33.0",
		"react-router": "^8.3.0",
		"react-router-dom": "^7.18.2",
		"tsdown": "^0.22.14",
		"typescript": "^7.0.2"
	},
	"peerDependencies": {
		"react": "^19.0.0"
	},
	"packageManager": "pnpm@11.20.0"
}
