{
	"name": "@sirosfoundation/ui",
	"description": "Web UI library",
	"version": "0.0.0",
	"type": "module",
	"license": "BSD-2-Clause",
	"exports": {
		"./css": {
			"types": "./types/css.d.ts",
			"default": "./dist/css/index.css"
		},
		"./css/*": {
			"types": "./types/css.d.ts",
			"default": "./dist/css/*.css"
		},
		"./react": {
			"types": "./dist/react/index.d.mts",
			"default": "./dist/react/index.mjs"
		},
		"./react/*": {
			"types": "./dist/react/*.d.mts",
			"default": "./dist/react/*.mjs"
		}
	},
	"files": [
		"dist",
		"types"
	],
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"clean": "rm -rf dist/",
		"typecheck": "tsc --noEmit",
		"lint": "biome check",
		"lint:fix": "biome check --write",
		"format": "biome format --write",
		"docs:dev": "pnpm --filter ui-docs dev",
		"docs:build": "pnpm --filter ui-docs build"
	},
	"dependencies": {
		"@fontsource/inter": "^5.2.8"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.0",
		"@changesets/changelog-github": "^0.7.0",
		"@changesets/cli": "^2.31.0",
		"@types/node": "^26.0.0",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.2.3",
		"lucide-react": "^1.21.0",
		"react-router": "^8.0.1",
		"react-router-dom": "^7.18.0",
		"tsdown": "^0.22.3",
		"typescript": "^5.9.3"
	},
	"peerDependencies": {
		"react": "^19.0.0"
	},
	"packageManager": "pnpm@11.5.0"
}
